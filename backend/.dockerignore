*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# VCS / IDE
.git/
.gitignore
.vscode/
.idea/

# Secrets — never enter build context or image layers
.env
.env.*
!.env.example

# OS noise
.DS_Store
Thumbs.db
