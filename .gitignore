# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
.env.production

# Google Cloud credentials - NEVER commit
*credentials*.json
*service-account*.json
gcp-credentials.json
**/gcp-credentials.json
**/google-*.json
**/woodpecker-*.json
!/.github

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# python extraction services (moved inside project as docling-extraction-service)
docling-extraction-service/.venv/
docling-extraction-service/.venv/**
docling-extraction-service/__pycache__/
docling-extraction-service/.pytest_cache/
docling-extraction-service/outputs/
docling-extraction-service/uploads/
docling-extraction-service/build/
docling-extraction-service/.artifacts/
docling-extraction-service/llamacpp/
**/.venv/
**/__pycache__/
**/.pytest_cache/
